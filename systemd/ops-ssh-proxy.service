[Unit]
Description=ops-ssh-proxy - SSH reverse proxy for AI agents
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/data/ops-ssh-proxy
Environment=SSH_LISTEN_ADDR=
Environment=WEB_LISTEN_ADDR=127.0.0.1:8080
EnvironmentFile=-/data/ops-ssh-proxy/ops-ssh-proxy.env
ExecStart=/data/ops-ssh-proxy/ops-ssh-proxy \
  -db /data/ops-ssh-proxy/ops-ssh-proxy.db \
  -host-key /data/ops-ssh-proxy/host_key

Restart=on-failure
RestartSec=2s

# 服务按部署约定使用 root 运行,但仍通过 systemd 限制文件系统和提权能力。
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/ops-ssh-proxy
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
